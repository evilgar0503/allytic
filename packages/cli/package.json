{
  "name": "allytic",
  "version": "0.0.0",
  "private": true,
  "description": "Command-line accessibility auditor",
  "license": "MIT",
  "type": "module",
  "bin": {
    "allytic": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@allytic/core": "workspace:*",
    "@axe-core/playwright": "4.13.0",
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "zod": "4.6.5"
  }
}
